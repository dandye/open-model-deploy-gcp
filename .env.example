# ==============================================================================
# Google Cloud & Gemma Deployment Environment Configuration
# ==============================================================================

# Google Cloud Project & Region Settings
GCP_PROJECT_ID="dandye-0324-chronicle"
GCP_REGION="us-central1"

# Hugging Face Access Token (Required for gated Gemma models)
HF_TOKEN=""

# ------------------------------------------------------------------------------
# Vertex AI Online Prediction Settings
# ------------------------------------------------------------------------------
VERTEX_MODEL_ID="gemma-3-12b-it-1747240724884"
VERTEX_ENDPOINT_NAME="gemma-endpoint"
VERTEX_DEPLOYMENT_NAME="gemma-3-12b-deployment"
VERTEX_MACHINE_TYPE="g2-standard-48"
VERTEX_ACCELERATOR_TYPE="nvidia-l4"
VERTEX_ACCELERATOR_COUNT="4"

# ------------------------------------------------------------------------------
# Cloud Run (Serverless GPU) Settings
# ------------------------------------------------------------------------------
CLOUDRUN_SERVICE_NAME="gemma-cloudrun-service"
CLOUDRUN_MODEL_NAME="google/gemma-2-9b-it"
CLOUDRUN_CONTAINER_IMAGE="vllm/vllm-openai:latest"
CLOUDRUN_CPU="8"
CLOUDRUN_MEMORY="32Gi"
CLOUDRUN_GPU_COUNT="1"
CLOUDRUN_GPU_TYPE="nvidia-l4"
CLOUDRUN_MIN_INSTANCES="0"
CLOUDRUN_MAX_INSTANCES="1"
CLOUDRUN_TIMEOUT="900"
CLOUDRUN_SWAP_SPACE="4"
CLOUDRUN_GPU_MEMORY_UTILIZATION="0.90"
CLOUDRUN_MAX_MODEL_LEN="4096"
