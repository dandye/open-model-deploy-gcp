{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/open-model-deploy-gcp/experiment-provenance.schema.json",
  "title": "Evaluation experiment provenance",
  "description": "Required provenance contract for future evaluation result artifacts. Historical artifacts are not rewritten to satisfy it.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "source_commit",
    "model",
    "configuration_hash",
    "dataset",
    "runbook",
    "evaluator",
    "started_at",
    "completed_at",
    "logs",
    "lifecycle"
  ],
  "properties": {
    "source_commit": {
      "type": "string",
      "minLength": 1,
      "description": "Exact source revision used to execute the run."
    },
    "model": {
      "$ref": "#/$defs/identity",
      "description": "Observed requested model/configuration plus resolved serving identity. Implementations should record observed and resolved subobjects when available; use an explicit unknown marker when resolution was not captured."
    },
    "configuration_hash": {
      "type": "string",
      "minLength": 1,
      "description": "Stable hash of model, serving, evaluator, and runtime configuration."
    },
    "configuration": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "observed": { "type": "object", "additionalProperties": true },
        "resolved": {
          "anyOf": [
            { "type": "object", "additionalProperties": true },
            { "$ref": "#/$defs/unknown" }
          ]
        }
      },
      "description": "Configuration values observed at invocation and values resolved by the serving platform."
    },
    "dataset": {
      "$ref": "#/$defs/identity",
      "description": "Dataset identity, revision, and split."
    },
    "runbook": {
      "$ref": "#/$defs/identity",
      "description": "Runbook identity, revision/hash, and enabled configuration."
    },
    "evaluator": {
      "$ref": "#/$defs/identity",
      "description": "Evaluator implementation/version and scoring configuration."
    },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "logs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/logReference" }
    },
    "lifecycle": {
      "type": "object",
      "required": ["status", "outcome_refs"],
      "additionalProperties": true,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["success", "failed", "cancelled", "timeout", "partial"]
        },
        "outcome_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/logReference" },
          "description": "References to evaluator, artifact-collection, and cleanup outcomes."
        }
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true,
      "description": "Non-empty identity object. A run may use name/version_or_revision or path/hash/file references, but must preserve enough fields to identify the observed input and resolved output.",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version_or_revision": { "type": "string", "minLength": 1 },
        "hash": { "type": "string", "minLength": 1 }
      }
    },
    "unknown": {
      "type": "object",
      "required": ["status", "reason"],
      "additionalProperties": true,
      "properties": {
        "status": { "const": "unknown" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "logReference": {
      "type": "object",
      "required": ["uri", "kind"],
      "additionalProperties": true,
      "properties": {
        "uri": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["evaluator", "artifact", "cleanup", "runtime", "other"] },
        "sha256": { "type": "string", "minLength": 1 }
      }
    }
  }
}
